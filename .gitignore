/*
!.gitignore
!/index.html
!/story.html
!/merch.html
!/petition.html
!/visit.html
!/catalog.html
!/keykeepers.html
!/terms.html
!/privacy.html
!/shipping.html
!/returns.html
!/cart.html
!/checkout.html
!/admin.html
!/sitemap.xml
!/robots.txt
!/README.md
!/netlify.toml
!/assets/
!/assets/**

# Raw brand-logo source files (originals dropped into assets/brands/ for the
# Stage-3 pipeline) stay local — like the Thrive exports and brand-logo-map.csv.
# Only the processed, shipped logos under assets/brands/processed/ are tracked.
/assets/brands/*.png
/assets/brands/*.jpg
/assets/brands/*.jpeg
/assets/brands/*.gif
/assets/brands/*.webp
!/css/
!/css/**
!/js/
!/js/**
!/data/
!/data/**
!/netlify/
!/netlify/**
!/scripts/
!/scripts/**
!/online-exclude.csv
!/online-override.csv

# Generated sync report stays out of git (data/** is whitelisted above)
/data/sync-unmatched.txt

# Raw Thrive exports (any other *.csv in root) are ignored by the /* rule above,
# so weekly dumps never get committed. Only the two manual lists are whitelisted.

# Local Netlify folder
.netlify
